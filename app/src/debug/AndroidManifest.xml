<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only shell control for the blocking host harness. Release has no such component. -->
        <receiver
            android:name=".HostHarnessStateReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="cool.jacoblin.particeps.HOST_HARNESS_QUERY" />
                <action android:name="cool.jacoblin.particeps.HOST_HARNESS_PROVISION" />
                <action android:name="cool.jacoblin.particeps.HOST_HARNESS_RESET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
