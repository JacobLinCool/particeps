{
  "name": "@adc/ciphertext-receiver",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir dist",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "pnpm test:unit && pnpm test:workerd",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "24.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.21.0"
}
