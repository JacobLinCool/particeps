# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# The Gradle wrapper JAR is deliberately committed: without it a fresh clone cannot build at all,
# which is what broke the first CI run here. The negation has to follow *.jar above, because the
# last matching rule wins. CI verifies the JAR against Gradle's published checksums, so the one
# binary in this tree is checkable rather than merely trusted.
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Android and Gradle
.gradle/
.idea/
**/build/
local.properties
captures/

# Eclipse/Buildship copies each module's sources into bin/, so these are stale
# duplicates of src/ that would otherwise be committed.
bin/
.classpath
.project
.settings/

# Research and Android signing secrets. The two negated files are deliberately
# public emulator fixtures and must never be reused for a real study.
.signing/
*-private.key
*-private.json
*.jks
*.keystore
*.adcexp
!researcher-tools/examples/INSECURE-demo-signing-private.key
!researcher-tools/examples/INSECURE-demo-hpke-private.json
